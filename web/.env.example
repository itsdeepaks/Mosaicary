# Public Supabase client configuration for Slice 10.1a+.
# Retrieve both values from the Tessli project's Connect panel once the
# separately approved cloud-project slice is unblocked.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Never place a Supabase secret key or service-role key in this file or in a
# NEXT_PUBLIC_ variable. Slice 10.1a requires no private server credential.
