# Canonical public application URL used for auth redirects and callback links.
# Use http://localhost:3000 in a local .env.local file during development.
NEXT_PUBLIC_SITE_URL=https://tessli.vercel.app

# Public Supabase browser/server client configuration.
# Leave both values empty until a Tessli Supabase project is created, then copy
# the project URL and publishable key from the Supabase Connect panel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never place a Supabase secret key or service-role key in this file or in a
# NEXT_PUBLIC_ variable. Tessli's browser and SSR auth clients do not require
# a private server credential.
