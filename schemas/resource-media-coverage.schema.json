{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tessli:schema:resource-media-coverage:v1",
  "title": "Tessli Resource Media Coverage",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "resources"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resourceCoverage" }
    }
  },
  "$defs": {
    "date": { "type": "string", "format": "date" },
    "resourceCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceId", "disposition"],
      "properties": {
        "resourceId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "disposition": {
          "type": "string",
          "enum": [
            "pending",
            "approved-media",
            "no-suitable-raster",
            "blocked",
            "failed",
            "rejected"
          ]
        },
        "checkedAt": { "$ref": "#/$defs/date" },
        "notes": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "disposition": { "const": "pending" } },
            "required": ["disposition"]
          },
          "then": { "not": { "required": ["checkedAt"] } },
          "else": { "required": ["checkedAt"] }
        }
      ]
    }
  }
}
