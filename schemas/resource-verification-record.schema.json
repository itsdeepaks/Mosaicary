{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tessli.dev/schemas/resource-verification-record.schema.json",
  "title": "Tessli Resource Verification Record",
  "description": "Versioned human-operator review evidence for one canonical Tessli source profile. A valid record does not itself promote source coverage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "recordVersion",
    "resourceId",
    "resourceSlug",
    "profileSha256",
    "profileReviewedAt",
    "status",
    "startedAt",
    "completedAt",
    "reviewer",
    "availabilityCheck",
    "claimChecks",
    "interfaceChecks",
    "governanceCheck",
    "limitationsReviewed",
    "freshness",
    "decision",
    "decisionNotes"
  ],
  "properties": {
    "contract": {
      "type": "string",
      "const": "tessli.resource-verification.v1"
    },
    "recordVersion": {
      "type": "integer",
      "const": 1
    },
    "resourceId": {
      "type": "string",
      "pattern": "^resource-[a-f0-9]{12}$"
    },
    "resourceSlug": {
      "$ref": "#/$defs/slug"
    },
    "profileSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profileReviewedAt": {
      "$ref": "#/$defs/date"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "completed"]
    },
    "startedAt": {
      "$ref": "#/$defs/date"
    },
    "completedAt": {
      "oneOf": [
        { "$ref": "#/$defs/date" },
        { "type": "null" }
      ]
    },
    "reviewer": {
      "$ref": "#/$defs/reviewer"
    },
    "availabilityCheck": {
      "$ref": "#/$defs/availabilityCheck"
    },
    "claimChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claimCheck"
      }
    },
    "interfaceChecks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interfaceCheck"
      }
    },
    "governanceCheck": {
      "$ref": "#/$defs/governanceCheck"
    },
    "limitationsReviewed": {
      "type": "boolean"
    },
    "freshness": {
      "$ref": "#/$defs/freshness"
    },
    "decision": {
      "type": "string",
      "enum": ["pending", "verified", "needs-review", "rejected"]
    },
    "decisionNotes": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "optionalDate": {
      "oneOf": [
        { "$ref": "#/$defs/date" },
        { "type": "null" }
      ]
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "displayName"],
      "properties": {
        "type": {
          "type": "string",
          "const": "human-operator"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^\\s]+$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 160
        }
      }
    },
    "checkResult": {
      "type": "string",
      "enum": ["pending", "confirmed", "contradicted", "uncertain"]
    },
    "checkMethod": {
      "type": "string",
      "enum": [
        "not-run",
        "document-review",
        "manual-browser",
        "manual-api-test",
        "manual-cli-test"
      ]
    },
    "availabilityCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "method", "checkedAt", "observedUrl", "notes"],
      "properties": {
        "result": {
          "type": "string",
          "enum": ["pending", "passed", "failed", "unknown"]
        },
        "method": {
          "$ref": "#/$defs/checkMethod"
        },
        "checkedAt": {
          "$ref": "#/$defs/optionalDate"
        },
        "observedUrl": {
          "$ref": "#/$defs/httpsUrl"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "claimCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "sourceUrl",
        "sourceType",
        "result",
        "method",
        "checkedAt",
        "notes"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "sourceUrl": {
          "$ref": "#/$defs/httpsUrl"
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "official-documentation",
            "official-product-page",
            "official-legal-page",
            "repository",
            "manual-test",
            "other"
          ]
        },
        "result": {
          "$ref": "#/$defs/checkResult"
        },
        "method": {
          "$ref": "#/$defs/checkMethod"
        },
        "checkedAt": {
          "$ref": "#/$defs/optionalDate"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "interfaceCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "transport",
        "result",
        "method",
        "checkedAt",
        "credentialHandling",
        "persistencePolicy",
        "notes"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["mcp", "api", "cli", "sdk", "plugin"]
        },
        "transport": {
          "type": "string",
          "enum": [
            "http",
            "sse",
            "stdio",
            "websocket",
            "local-process",
            "in-product"
          ]
        },
        "result": {
          "type": "string",
          "enum": ["pending", "passed", "failed", "not-applicable", "unknown"]
        },
        "method": {
          "$ref": "#/$defs/checkMethod"
        },
        "checkedAt": {
          "$ref": "#/$defs/optionalDate"
        },
        "credentialHandling": {
          "type": "string",
          "enum": [
            "none-required",
            "user-owned-not-recorded",
            "workspace-owned-not-recorded",
            "not-tested",
            "unknown"
          ]
        },
        "persistencePolicy": {
          "type": "string",
          "enum": [
            "persistent",
            "metadata-only",
            "transient",
            "prohibited",
            "unknown"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "governanceCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persistence",
        "redistribution",
        "attribution",
        "terms",
        "termsUrl",
        "checkedAt",
        "notes"
      ],
      "properties": {
        "persistence": { "$ref": "#/$defs/checkResult" },
        "redistribution": { "$ref": "#/$defs/checkResult" },
        "attribution": { "$ref": "#/$defs/checkResult" },
        "terms": { "$ref": "#/$defs/checkResult" },
        "termsUrl": {
          "oneOf": [
            { "$ref": "#/$defs/httpsUrl" },
            { "type": "null" }
          ]
        },
        "checkedAt": { "$ref": "#/$defs/optionalDate" },
        "notes": {
          "type": "string",
          "maxLength": 1500
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "recheckBy"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "current", "aging", "stale"]
        },
        "recheckBy": {
          "$ref": "#/$defs/optionalDate"
        }
      }
    }
  }
}
