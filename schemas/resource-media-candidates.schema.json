{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tessli:schema:resource-media-candidates:v1",
  "title": "Tessli Resource Media Candidates",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "resources"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "resources": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/resourceCandidate" }
    }
  },
  "$defs": {
    "date": { "type": "string", "format": "date" },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^https://"
    },
    "rasterImage": {
      "type": "string",
      "enum": ["image/avif", "image/jpeg", "image/png", "image/webp"]
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "url": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "source", "contentType", "provenance", "checkedAt"],
      "properties": {
        "url": { "$ref": "#/$defs/httpsUrl" },
        "source": { "type": "string", "enum": ["manual", "open-graph"] },
        "contentType": { "$ref": "#/$defs/rasterImage" },
        "provenance": {
          "type": "string",
          "enum": ["response-header", "manual-review"]
        },
        "checkedAt": { "$ref": "#/$defs/date" }
      }
    },
    "favicon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "contentType", "provenance", "checkedAt"],
      "properties": {
        "url": { "$ref": "#/$defs/httpsUrl" },
        "contentType": { "$ref": "#/$defs/rasterImage" },
        "provenance": {
          "type": "string",
          "enum": ["response-header", "manual-review"]
        },
        "checkedAt": { "$ref": "#/$defs/date" }
      }
    },
    "resourceCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "resourceName",
        "canonicalUrl",
        "discoveryStatus",
        "reviewerStatus"
      ],
      "properties": {
        "resourceId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "resourceName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "canonicalUrl": { "$ref": "#/$defs/httpsUrl" },
        "sourcePageUrl": { "$ref": "#/$defs/httpsUrl" },
        "checkedAt": { "$ref": "#/$defs/date" },
        "discoveryStatus": {
          "type": "string",
          "enum": [
            "pending",
            "candidate",
            "blocked",
            "failed",
            "no-raster-media",
            "uncertain",
            "rejected"
          ]
        },
        "reviewerStatus": {
          "type": "string",
          "enum": ["unreviewed", "needs-review", "approved-for-copy", "rejected"]
        },
        "redirects": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/httpsUrl" }
        },
        "preview": { "$ref": "#/$defs/preview" },
        "favicon": { "$ref": "#/$defs/favicon" },
        "issues": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/issue" }
        },
        "notes": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "discoveryStatus": { "const": "candidate" } }
          },
          "then": {
            "required": ["sourcePageUrl", "checkedAt"],
            "anyOf": [
              { "required": ["preview"] },
              { "required": ["favicon"] }
            ]
          }
        },
        {
          "if": {
            "properties": { "reviewerStatus": { "const": "approved-for-copy" } }
          },
          "then": {
            "properties": { "discoveryStatus": { "const": "candidate" } },
            "required": ["sourcePageUrl", "checkedAt"],
            "anyOf": [
              { "required": ["preview"] },
              { "required": ["favicon"] }
            ]
          }
        }
      ]
    }
  }
}
