{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-intelligence.local/schemas/repair-log/v1",
  "title": "Repair Log v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "condition", "maximum_repairs", "repairs"],
  "properties": {
    "version": {"const": 1},
    "condition": {"enum": ["baseline", "ui-plan"]},
    "maximum_repairs": {"const": 2},
    "repairs": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["turn", "mechanical_evidence", "outcome"],
        "properties": {
          "turn": {"type": "integer", "minimum": 1, "maximum": 2},
          "mechanical_evidence": {"type": "array", "minItems": 1, "items": {"enum": ["overflow", "console-error", "page-error", "interaction-failure", "csv-load-failure", "axe-violation"]}},
          "evidence_path": {"type": "string"},
          "outcome": {"enum": ["fixed", "not-fixed", "not-attempted"]}
        }
      }
    }
  }
}
