{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-intelligence.local/schemas/ui-contract/v1",
  "title": "UI Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "screen", "user", "hierarchy", "patterns", "layout", "components", "states", "accessibility", "verification", "status"],
  "properties": {
    "version": {"const": 1},
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "goal"],
      "properties": {"id": {"type": "string"}, "type": {"type": "string"}, "goal": {"type": "string"}}
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "state", "primary_question"],
      "properties": {"role": {"type": "string"}, "state": {"type": "string"}, "primary_question": {"type": "string"}}
    },
    "context_ref": {"type": "string"},
    "hierarchy": {"type": "object", "additionalProperties": false, "required": ["primary", "secondary"], "properties": {"primary": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "secondary": {"type": "array", "items": {"type": "string"}}}},
    "patterns": {"type": "object", "additionalProperties": false, "required": ["selected", "avoided", "rationale"], "properties": {"selected": {"type": "array", "items": {"type": "string"}}, "avoided": {"type": "array", "items": {"type": "string"}}, "rationale": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "layout": {"type": "object", "additionalProperties": false, "required": ["desktop", "tablet", "mobile"], "properties": {"desktop": {"type": "string"}, "tablet": {"type": "string"}, "mobile": {"type": "string"}}},
    "components": {"type": "object", "additionalProperties": false, "required": ["reuse", "new", "prohibited"], "properties": {"reuse": {"type": "array", "items": {"type": "string"}}, "new": {"type": "array", "items": {"type": "string"}}, "prohibited": {"type": "array", "items": {"type": "string"}}}},
    "states": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "interaction": {"type": "object"},
    "visual": {"type": "object"},
    "accessibility": {"type": "object", "additionalProperties": false, "required": ["target", "requirements"], "properties": {"target": {"type": "string"}, "requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "verification": {"type": "object", "additionalProperties": false, "required": ["viewports", "required_checks"], "properties": {"viewports": {"type": "array", "minItems": 2, "items": {"type": "string"}}, "required_checks": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["draft", "approved", "blocked"]}
  }
}
