{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-intelligence.local/schemas/project-ui-context/v1",
  "title": "Project UI Context v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "product", "users", "constraints", "sources"],
  "properties": {
    "version": {"const": 1},
    "project": {"type": "string", "minLength": 1},
    "product": {"type": "string", "minLength": 1},
    "users": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "jobs": {"type": "array", "items": {"type": "string"}},
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "repository_components", "accessibility_target"],
      "properties": {
        "platform": {"type": "string"},
        "repository_components": {"type": "array", "items": {"type": "string"}},
        "design_tokens": {"type": "array", "items": {"type": "string"}},
        "accessibility_target": {"type": "string"},
        "prohibited_dependencies": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "facts": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "string"}}
  }
}
