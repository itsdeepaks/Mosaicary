{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-intelligence.local/schemas/review/v1",
  "title": "Evaluation Review v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "review_type", "scores", "evidence", "status"],
  "properties": {
    "version": {"const": 1},
    "review_type": {"enum": ["planning", "implementation", "blind-comparison"]},
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_fit", "information_hierarchy", "visual_coherence", "project_consistency", "responsive_quality", "interaction_completeness", "accessibility", "implementation_quality", "overall_preference"],
      "properties": {
        "task_fit": {"type": "integer", "minimum": 1, "maximum": 5},
        "information_hierarchy": {"type": "integer", "minimum": 1, "maximum": 5},
        "visual_coherence": {"type": "integer", "minimum": 1, "maximum": 5},
        "project_consistency": {"type": "integer", "minimum": 1, "maximum": 5},
        "responsive_quality": {"type": "integer", "minimum": 1, "maximum": 5},
        "interaction_completeness": {"type": "integer", "minimum": 1, "maximum": 5},
        "accessibility": {"type": "integer", "minimum": 1, "maximum": 5},
        "implementation_quality": {"type": "integer", "minimum": 1, "maximum": 5},
        "overall_preference": {"enum": ["A", "B", "tie", "not-scored"]}
      }
    },
    "evidence": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["draft", "complete", "not-scored"]}
  }
}
