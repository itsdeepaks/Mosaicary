{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-intelligence.local/schemas/contract-review/v1",
  "title": "UI Contract Review v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "contract", "requirements", "overall_usefulness"],
  "properties": {
    "version": {"const": 1},
    "contract": {"type": "string"},
    "overall_usefulness": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_field", "requirement", "usefulness", "adherence", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "source_field": {"type": "string"},
          "requirement": {"type": "string"},
          "usefulness": {"enum": ["useful-and-followed", "useful-but-ignored", "already-obvious-from-task", "too-vague-to-implement", "unnecessary-constraint", "incorrect-recommendation", "not-applicable"]},
          "adherence": {"enum": ["implemented", "partially-implemented", "not-implemented", "contradicted", "not-applicable"]},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
