{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-intelligence.local/schemas/evaluation-run/v1",
  "title": "Evaluation Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "task_id", "condition", "phase", "status", "frozen_conditions", "artifacts"],
  "properties": {
    "version": {"const": 1},
    "task_id": {"type": "string"},
    "condition": {"enum": ["baseline", "ui-plan"]},
    "phase": {"enum": ["plan", "build", "review", "dry-run"]},
    "status": {"enum": ["ready", "running", "complete", "blocked", "non-evaluative"]},
    "frozen_conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_commit", "model", "reasoning_level", "prompt_sha256", "run_allowance", "tools", "verification_process"],
      "properties": {
        "repository_commit": {"type": "string"},
        "model": {"type": "string"},
        "reasoning_level": {"type": "string"},
        "prompt_sha256": {"type": "string"},
        "run_allowance": {"type": "string"},
        "tools": {"type": "array", "items": {"type": "string"}},
        "verification_process": {"type": "string"},
        "network_policy": {"type": "string"},
        "source_access": {"type": "string"},
        "max_repair_turns": {"type": "integer", "minimum": 0}
      }
    },
    "starting_commit": {"type": "string"},
    "ending_commit": {"type": "string"},
    "skill_available": {"type": "boolean"},
    "skill_artifacts_read": {"type": "boolean"},
    "ui_plan_artifacts_read": {"type": "boolean"},
    "baseline_artifacts_read": {"type": "boolean"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "metrics": {"type": "object"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
