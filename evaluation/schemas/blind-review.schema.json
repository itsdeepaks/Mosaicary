{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-intelligence.local/schemas/blind-review/v2",
  "title": "Blind Review v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "reviewer_kind", "condition_mapping_known", "scores", "ship_choice", "evidence", "status"],
  "properties": {
    "version": {"const": 2},
    "reviewer_kind": {"enum": ["human", "ai-delegated"]},
    "condition_mapping_known": {"type": "boolean"},
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version_a", "version_b"],
      "properties": {
        "version_a": {"$ref": "#/$defs/scoreCard"},
        "version_b": {"$ref": "#/$defs/scoreCard"}
      }
    },
    "ship_choice": {"enum": ["A", "B", "tie", "not-scored"]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["draft", "complete", "not-scored"]}
  },
  "$defs": {
    "scoreCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_fit", "information_hierarchy", "mobile_usability", "control_discoverability", "density", "visual_coherence", "repository_consistency", "component_reuse", "accessibility", "implementation_restraint", "desktop_regression_risk", "ship_readiness"],
      "properties": {
        "task_fit": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "information_hierarchy": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "mobile_usability": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "control_discoverability": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "density": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "visual_coherence": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "repository_consistency": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "component_reuse": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "accessibility": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "implementation_restraint": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "desktop_regression_risk": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "ship_readiness": {"type": ["integer", "null"], "minimum": 1, "maximum": 5}
      }
    }
  }
}
