{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-intelligence.local/schemas/browser-evidence/v1",
  "title": "Browser Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "url", "viewports", "csv_failure", "axe", "passed"],
  "properties": {
    "version": {"const": 1},
    "url": {"type": "string"},
    "viewports": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "interactions": {"type": "object"},
    "csv_failure": {"type": "object"},
    "axe": {"type": "object"},
    "passed": {"type": "boolean"}
  }
}
