{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-intelligence.local/schemas/source-request-plan/v1",
  "title": "Source Request Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "evidence_needed", "local_inspection_complete"],
  "properties": {
    "version": {"const": 1},
    "local_inspection_complete": {"type": "boolean"},
    "evidence_needed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "query", "purpose", "preferred_source_order", "blocking"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["product-pattern", "local-component", "design-system-guidance", "visual-reference", "accessibility-guidance", "content-guidance"]},
          "query": {"type": "string"},
          "purpose": {"type": "string"},
          "preferred_source_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "blocking": {"type": "boolean"}
        }
      }
    }
  }
}
