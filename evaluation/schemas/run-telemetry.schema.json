{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-intelligence.local/schemas/run-telemetry/v1",
  "title": "Evaluation Run Telemetry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "condition", "started_at", "ended_at", "elapsed_ns", "elapsed_seconds", "token_usage"],
  "properties": {
    "version": {"const": 1},
    "condition": {"enum": ["baseline", "ui-plan"]},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "elapsed_ns": {"type": "integer", "minimum": 0},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "token_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "input_tokens", "output_tokens", "total_tokens", "reason"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reason": {"type": "string"}
      }
    }
  }
}
